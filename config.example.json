      "websocketUrl": "ws://127.0.0.1:11180/sub",
      "reconnectIntervalMs": 5000
    }
  },
  "youtube": {
    "enabled": false,
    "clientId": "YOUR_YOUTUBE_OAUTH_CLIENT_ID",
